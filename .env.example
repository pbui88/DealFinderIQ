# Supabase — create project at https://supabase.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Maps API — https://console.cloud.google.com
# Enable: Maps JavaScript API, Street View Static API, Geocoding API
VITE_GOOGLE_MAPS_KEY=your-google-maps-key-for-frontend
GOOGLE_MAPS_KEY=your-google-maps-key-for-backend

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Positionstack — https://positionstack.com (reverse geocoding, free 25k/month)
POSITIONSTACK_API_KEY=your-positionstack-api-key

# OpenAI — https://platform.openai.com (no longer used for analysis)
OPENAI_API_KEY=your-openai-api-key

# Admin email(s) — comma separated
VITE_ADMIN_EMAILS=admin@example.com

# Production URL — set in Netlify env vars
VITE_SITE_URL=https://your-dealfinderiq-app.netlify.app

# Stripe — https://dashboard.stripe.com (Checkout for credit purchases)
# Use test mode keys (sk_test_...) during development, live keys (sk_live_...) in production.
# The key's prefix determines test vs. live — no separate environment flag needed.
STRIPE_SECRET_KEY=your-stripe-secret-key
# Webhook signing secret — Dashboard > Developers > Webhooks > add endpoint > Signing secret.
# Webhook URL: https://your-dealfinderiq-app.netlify.app/.netlify/functions/stripe-webhook
# Event to subscribe to: checkout.session.completed
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Admin Monitor — alert thresholds (all optional, defaults shown)
# Database/storage alerts trigger at 75% (warning) and 90% (critical) of these limits.
SUPABASE_DB_LIMIT_BYTES=8589934592        # 8 GB  (Supabase Pro plan default)
SUPABASE_STORAGE_LIMIT_BYTES=107374182400 # 100 GB (Supabase Pro plan default)

# Tracerfy Skip Trace — https://tracerfy.com
# API key from your Tracerfy account dashboard.
# Webhook URL — configure in Tracerfy account settings.
# PREFERRED (secret in header, not logged): set Authorization header to "Bearer <TRACERFY_WEBHOOK_SECRET>"
#   https://your-dealfinderiq-app.netlify.app/.netlify/functions/tracerfy-webhook
# FALLBACK (if Tracerfy does not support custom headers — secret appears in server logs):
#   https://your-dealfinderiq-app.netlify.app/.netlify/functions/tracerfy-webhook?secret=<TRACERFY_WEBHOOK_SECRET>
TRACERFY_API_KEY=your-tracerfy-api-key
# Random secret used to authenticate Tracerfy webhook calls (min 32 random chars recommended).
TRACERFY_WEBHOOK_SECRET=your-random-webhook-secret

# Optional 30-day API spend budget — alert at 90% and 100% of this amount
MONTHLY_API_BUDGET_USD=
